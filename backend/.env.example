# ==============================================================================
# Cyberbullying Research Platform - Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' in the /backend directory and configure your settings.
# In production, NEVER commit secret values to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB 6+)
# For local development:
mongodb+srv://24pwbcs1261_db_user:FLNtaLd2IYSZnFr0@cluster1.cy0uc3w.mongodb.net/?appName=Cluster1
# For production replica set with authentication:
# MONGODB_URI=mongodb://<username>:<password>@<host>:27017/cyberbullying-research?authSource=admin&replicaSet=rs0

# Session Management & Security
# CRITICAL: In production (NODE_ENV=production), SESSION_SECRET MUST be >= 32 characters
SESSION_SECRET=development-secret-change-in-production-min-32-chars

# Frontend Application Origin (CORS Configuration)
FRONTEND_URL=http://localhost:3000

# Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS=900000     # 15 minutes (default)
# RATE_LIMIT_MAX_REQUESTS=1000    # Max requests per window

# Python FastAPI NLP Microservice Configuration (Phases 2-8)
# Set to 'true' to enable the neural NLP microservice (RoBERTa + Detoxify + Lexicon + Operational criteria)
NLP_PROVIDER_ENABLED=true

# Transparent Fallback: If 'true', automatically falls back to RuleBasedProvider if microservice is offline
NLP_FALLBACK_ENABLED=true

# URL of the running Python FastAPI microservice (default port: 8001)
NLP_SERVICE_URL=http://127.0.0.1:8001

# HTTP Request Timeout for NLP analysis in milliseconds (default: 30000)
NLP_SERVICE_TIMEOUT_MS=30000
